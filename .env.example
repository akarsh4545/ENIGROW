# =============================================================================
# Enigrow — Environment Variables (EXAMPLE)
# Copy to .env.local and fill in real values. NEVER commit secrets.
# Add the same keys in Vercel → Project Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# App (public)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Enigrow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourdomain.com"
NEXT_PUBLIC_SUPPORT_PHONE="+91XXXXXXXXXX"
NEXT_PUBLIC_WHATSAPP_NUMBER="91XXXXXXXXXX"

# -----------------------------------------------------------------------------
# MongoDB Atlas (required for auth, leads, assessments)
# -----------------------------------------------------------------------------
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?appName=Enigrow"
MONGODB_DB_NAME="consultvault"

# -----------------------------------------------------------------------------
# NextAuth / Auth.js v5 (required)
# Generate AUTH_SECRET: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Optional Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# -----------------------------------------------------------------------------
# Cloudinary (optional — media uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# -----------------------------------------------------------------------------
# Resend (optional — enquiry / assessment emails)
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Enigrow <onboarding@resend.dev>"

# -----------------------------------------------------------------------------
# Razorpay (optional — payments)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
